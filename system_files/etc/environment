# For nvidia hardware acceleration in browsers
MOZ_DISABLE_RDD_SANDBOX=1
LIBVA_DRIVER_NAME=nvidia
CUDA_DISABLE_PERF_BOOST=1

# Use DLSS Preset K
PROTON_DLSS_UPGRADE=1
DXVK_NVAPI_DRS_NGX_DLSS_SR_OVERRIDE_RENDER_PRESET_SELECTION=render_preset_k

# Increase Nvidia's shader cache size to 50GB
__GL_SHADER_DISK_CACHE_SIZE=50000000000

PROTON_LOCAL_SHADER_CACHE=1
