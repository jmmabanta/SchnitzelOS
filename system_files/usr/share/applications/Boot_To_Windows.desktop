[Desktop Entry]
Comment=Restarts the computer to boot into Windows
Exec=/usr/local/bin/boot-windows
Icon=system-reboot
Name=Reboot to Windows
NoDisplay=false
Path=
PrefersNonDefaultGPU=false
StartupNotify=true
Terminal=false
TerminalOptions=
Type=Application
X-KDE-SubstituteUID=false
X-KDE-Username=
