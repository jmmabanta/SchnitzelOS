# Installer environment for SchnitzelOS (Fedora 45, x86_64 only).
#
# This is NOT the OS image. It is the live environment (Anaconda + boot media
# tooling) that image-builder turns into an ISO. Anaconda then installs
# PAYLOAD_IMAGE (your real SchnitzelOS image) onto the target machine.
#
# Based on the Fedora 45 recipe from the image-builder docs:
#   https://osbuild.org/docs/developer-guide/projects/image-builder/bootc-generic-iso/
#   https://osbuild.org/docs/developer-guide/projects/image-builder/advanced/bootc/isos/
#
# Config files are written with printf rather than heredocs so this builds on
# older podman/buildah (the CI runner uses ubuntu-24.04, podman 4.9).
FROM quay.io/fedora/fedora-bootc:45

# The bootc image Anaconda installs. The workflow overrides this with
# --build-arg so it always matches IMAGE_REGISTRY/IMAGE_NAME/DEFAULT_TAG.
ARG PAYLOAD_IMAGE=ghcr.io/jmmabanta/schnitzel-os:latest
# Used both as the ISO volume label and in the GRUB entry below; keep them in sync.
ARG ISO_LABEL=SchnitzelOS-Installer

# Installer tools and boot media.
# isomd5sum (implantisomd5) is listed explicitly because image-builder requires
# it in the build container; the other build tools are xorrisofs/squashfs-tools.
# Wi-Fi in the installer needs BOTH the NetworkManager Wi-Fi plugin and the
# firmware for the chip. Fedora's own installer images list these explicitly
# (names taken from their F43/F44 image definitions); a bootc-based installer
# doesn't get them unless they are added here. If a name is ever renamed in a
# future release, the build fails with "No match for argument".
RUN dnf5 install -qy \
        --setopt=install_weak_deps=0 \
        --setopt=tsflags=nodocs \
        anaconda \
        anaconda-install-img-deps \
        anaconda-dracut \
        dracut-config-generic \
        dracut-network \
        net-tools \
        grub2-efi-x64-cdboot \
        plymouth \
        default-fonts-core-sans \
        google-noto-sans-cjk-vf-fonts \
        xorrisofs \
        squashfs-tools \
        isomd5sum \
        NetworkManager-wifi \
        iwlwifi-dvm-firmware \
        iwlwifi-mvm-firmware \
        atheros-firmware \
        brcmfmac-firmware \
        mt7xxx-firmware \
        realtek-firmware \
        nxpwireless-firmware \
        qcom-firmware && \
    dnf5 clean all

RUN mkdir -p /boot/efi && cp -ra /usr/lib/efi/*/*/EFI /boot/efi

# ISO GRUB boot menu
RUN mkdir -p /usr/lib/image-builder/bootc && \
    printf '%s\n' \
        "label: \"${ISO_LABEL}\"" \
        "grub2:" \
        "  entries:" \
        "    - name: \"Install SchnitzelOS\"" \
        "      linux: \"/images/pxeboot/vmlinuz inst.stage2=hd:LABEL=${ISO_LABEL} console=tty0 inst.graphical selinux=0 rhgb quiet\"" \
        "      initrd: \"/images/pxeboot/initrd.img\"" \
        > /usr/lib/image-builder/bootc/iso.yaml

# Tell Anaconda to install the bootc image. --target-imgref makes the installed
# system track the registry image for updates.
RUN printf '%s\n' \
        "bootc --source-imgref registry:${PAYLOAD_IMAGE} --target-imgref ${PAYLOAD_IMAGE}" \
        > /usr/share/anaconda/interactive-defaults.ks

# ---------------------------------------------------------------------------
# The following is what `lorax` normally does to make Anaconda work as a live
# environment; this is the bare minimum (copied from the upstream F45 recipe).
# Note the F45-specific repo path: repo configs moved to /usr/share/dnf5/repos.d.
# ---------------------------------------------------------------------------
RUN echo "install:x:0:0:root:/root:/usr/libexec/anaconda/run-anaconda" >> /etc/passwd && \
    echo "install::14438:0:99999:7:::" >> /etc/shadow && \
    passwd -d root

RUN mv /usr/share/anaconda/list-harddrives-stub /usr/bin/list-harddrives && \
    mv /usr/share/dnf5/repos.d /etc/anaconda.repos.d && \
    ln -s /lib/systemd/system/anaconda.target /etc/systemd/system/default.target && \
    rm -v /usr/lib/systemd/system-generators/systemd-gpt-auto-generator

RUN ln -s /usr/lib/systemd/system/anaconda-shell@.service /usr/lib/systemd/system/autovt@.service

RUN mkdir -p /usr/lib/systemd/logind.conf.d && \
    printf '%s\n' '[Login]' 'ReserveVT=2' \
        > /usr/lib/systemd/logind.conf.d/anaconda-shell.conf

# Max compression
RUN mkdir -p /etc/dracut.conf.d && \
    printf '%s\n' 'compress_level_xz="9"' \
        > /etc/dracut.conf.d/99-compression.conf

# Rebuild the initramfs with the anaconda dracut module
RUN mkdir -p "$(realpath /root)" && \
    kernel="$(find /usr/lib/modules -mindepth 2 -maxdepth 2 -name vmlinuz -printf '%h\n' -quit)" && \
    kernel="${kernel##*/}" && \
    DRACUT_NO_XATTR=1 dracut --force -v --xz --reproducible --no-hostonly \
        --add "anaconda" \
        "/usr/lib/modules/${kernel}/initramfs.img" "${kernel}"

# Let the root-run installer use pipewire
RUN mkdir -p /etc/systemd/user/pipewire.service.d /etc/systemd/user/pipewire.socket.d && \
    printf '%s\n' '[Unit]' 'ConditionUser=' \
        > /etc/systemd/user/pipewire.service.d/allowroot.conf && \
    printf '%s\n' '[Unit]' 'ConditionUser=' \
        > /etc/systemd/user/pipewire.socket.d/allowroot.conf
